# Same-host proxy only. Set ROOM_DOMAIN to the chosen hostname (no scheme).
# Do not put another CDN/proxy in front without reviewing client-IP handling.
{$ROOM_DOMAIN} {
    header Strict-Transport-Security "max-age=86400"
    reverse_proxy 127.0.0.1:4173 {
        header_up X-Real-IP {http.request.remote.host}
        flush_interval -1
    }
    # Access logging intentionally off: never log credentials or message bodies.
}
