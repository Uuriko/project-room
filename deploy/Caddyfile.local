# Local HTTPS proof only: the same reverse-proxy shape as deploy/Caddyfile, on
# an unprivileged port, with Caddy's own local CA (no public DNS, no ACME, no
# trust-store changes). scripts/selfhost-journey.mjs renders this with
# ROOM_DOMAIN=localhost:<port> and ROOM_UPSTREAM=127.0.0.1:<app port>.
# For a real host use deploy/Caddyfile instead.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	default_bind 127.0.0.1
}
{$ROOM_DOMAIN} {
	tls internal
	header Strict-Transport-Security "max-age=86400"
	reverse_proxy {$ROOM_UPSTREAM} {
		header_up X-Real-IP {http.request.remote.host}
		flush_interval -1
	}
	# Access logging intentionally off: never log credentials or message bodies.
}
