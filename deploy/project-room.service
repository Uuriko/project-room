[Unit]
Description=Project Room invite-only pilot
After=network.target

[Service]
Type=simple
User=project-room
Group=project-room
WorkingDirectory=/opt/project-room/current
EnvironmentFile=/etc/project-room/pilot.env
ExecStart=/usr/bin/node /opt/project-room/current/server.mjs
Restart=on-failure
RestartSec=5
# Graceful close drains SSE streams, writes the growth snapshot, closes the
# server and the store; give it a full minute before SIGKILL so a slow drain
# never tears the snapshot mid-write (see audit 2026-09-17).
TimeoutStopSec=60
UMask=0077
StateDirectory=project-room
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/project-room

[Install]
WantedBy=multi-user.target
