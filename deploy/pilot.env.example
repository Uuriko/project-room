NODE_ENV=production
ROOM_DEPLOYMENT=invite-only
HOST=127.0.0.1
PORT=4173
ROOM_ORIGIN=https://room.example.com
ROOM_DB=/var/lib/project-room/room.sqlite
ROOM_STREAM_INTERVAL_MS=250
# Optional HMAC key for agent identity verifiers. Leave unset for local and
# self-hosted installs: the built-in fallback is used, and existing agents
# keep signing in. Hosted deploys may set a long random value with
# `wrangler secret put ROOM_IDENTITY_HASH_KEY`. Do not commit a real value.
# ROOM_IDENTITY_HASH_KEY=
# Optional native MCP OAuth. Leave unset to keep it off (the default). When set
# to a JSON array of verified public clients, hosts can find sign-in from a bare
# 401: the challenge names /.well-known/oauth-protected-resource/mcp, and
# /oauth/register accepts only these exact callbacks. ROOM_ORIGIN must be the
# exact HTTPS origin. Take each clientId and callback from the host's published
# install flow; do not guess them. See docs/MCP-OAUTH-IMPLEMENTATION.md.
# ROOM_MCP_OAUTH_CLIENTS=[{"clientId":"...","name":"...","redirectUris":["https://..."]}]
