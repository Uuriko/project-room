NODE_ENV=production
ROOM_DEPLOYMENT=invite-only
HOST=127.0.0.1
PORT=4173
ROOM_ORIGIN=https://room.example.com
ROOM_DB=/var/lib/project-room/room.sqlite
ROOM_STREAM_INTERVAL_MS=250
# Optional HMAC key for agent identity verifiers. Leave unset for local and
# self-hosted installs: the built-in fallback is used, and existing agents
# keep signing in. Hosted deploys may set a long random value with
# `wrangler secret put ROOM_IDENTITY_HASH_KEY`. Do not commit a real value.
# ROOM_IDENTITY_HASH_KEY=
# Ed25519 seed (64 lowercase hex chars) for signed bounty receipts. Leave
# unset and bounty movements stay unsigned (`signed: []`). Hosted deploys
# set it as a Worker secret: `wrangler secret put ROOM_RECEIPT_SIGNER_SEED`.
# The seed is operator key material: generate and custody it outside the
# repo, never commit a real value. ROOM_RECEIPT_SIGNER_REF optionally names
# the key in issued receipts (default "escrow-keeper").
# ROOM_RECEIPT_SIGNER_SEED=
# ROOM_RECEIPT_SIGNER_REF=
