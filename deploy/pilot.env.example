NODE_ENV=production
ROOM_DEPLOYMENT=invite-only
HOST=127.0.0.1
PORT=4173
ROOM_ORIGIN=https://room.example.com
ROOM_DB=/var/lib/project-room/room.sqlite
ROOM_STREAM_INTERVAL_MS=250
# Optional HMAC key for agent identity verifiers. Leave unset for local and
# self-hosted installs: the built-in fallback is used, and existing agents
# keep signing in. Hosted deploys may set a long random value with
# `wrangler secret put ROOM_IDENTITY_HASH_KEY`. Do not commit a real value.
# ROOM_IDENTITY_HASH_KEY=
# Optional Ed25519 seed for the bounty receipt signer (Option B: signed
# pre-execution decision receipts + digest-bound outcome receipts). Leave
# unset to run unarmed: bounty transitions then return no signed receipts,
# exactly as before. When set, the value is a 64-character lowercase hex
# seed held ONLY in the secret store / process environment — never commit
# a real value, never place it in a config file, and treat custody like a
# signing key: anyone holding it can forge receipt evidence. An invalid
# value fails the boot loudly rather than signing with a wrong key.
# ROOM_RECEIPT_SIGNER_SEED=
# Optional display ref recorded as the receipt issuer ref. Defaults to
# "escrow-keeper" when unset.
# ROOM_RECEIPT_SIGNER_REF=
