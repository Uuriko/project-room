+            if nxt is None or nxt <= cursor:
+                raise RoomError(
+                    f"event cursor did not advance (after={cursor}, next={nxt}); "
+                    "refusing to loop forever"
+                )
+            cursor = nxt
+            pages += 1
+            if pages > 10000:
+                raise RoomError("event iteration exceeded 10000 pages; aborting")
