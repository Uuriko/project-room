diff --git a/tests/webhook-dispatch-store.test.js b/tests/webhook-dispatch-store.test.js
index 3d224a9a..71013c2e 100644
--- a/tests/webhook-dispatch-store.test.js
+++ b/tests/webhook-dispatch-store.test.js
@@ -623,3 +623,28 @@ test("dispatch skips a delivery whose identity was unlinked after fan-out", asyn
