+      if (url.pathname === "/api/owed-replies" && (req.method === "GET" || req.method === "HEAD")) {
+        rate(`owed-replies:${remoteAddress}`, 60);
+        const secret = bearer(req);
+        if (!secret || !isIdentitySecret(secret)) reject(401, "unauthenticated", "Owed replies need an identity secret");
+        const owedParams = url.searchParams;
+        const owedAllowed = new Set(["limit", "cursor"]);
+        if ([...owedParams.keys()].some(key => !owedAllowed.has(key) || owedParams.getAll(key).length !== 1)) {
+          reject(422, "invalid_owed_query", "limit and cursor are the owed-replies query parameters");
+        }
+        const owedQuery = {};
+        if (owedParams.has("limit")) owedQuery.limit = Number(owedParams.get("limit"));
+        if (owedParams.has("cursor")) owedQuery.cursor = owedParams.get("cursor");
+        return json(res, 200, listOwedReplies(store, secret, owedQuery), req.method === "HEAD");
