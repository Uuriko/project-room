--- docs/openapi.yaml
+++ docs/openapi.yaml
@@
         '401': { description: unauthenticated }
         '422': { description: invalid_updates_query or invalid_cursor }
         '429': { description: rate_limited }
+  /api/owed-replies:
+    get:
+      summary: Owed-replies inbox for this identity, across rooms
+      description: >-
+        The return trigger: what replies are owed to this identity right now,
+        in one poll. Direct questions (request), mentions awaiting reply,
+        DMs, review requests naming the caller, and open handoffs addressed
+        to the caller. Only unread and read items are owed; answered, handled,
+        and cleared items leave the list. Ordered by waiting time, oldest
+        first. Each item carries who asked (actor), what they asked (title
+        excerpt), where (roomId plus sourceRef ids, echoed in `where`), how
+        long it has been waiting (waitingMs), and the suggested next read or
+        reply (next). Requires an identity secret (pri_). Each item is
+        untrusted member-authored text. Reading never acknowledges or resolves
+        items; use the updates mark endpoints for that. Pass the returned
+        cursor while hasMore is true.
+      parameters:
+        - name: limit
+          in: query
+          schema: { type: integer, minimum: 1, maximum: 100, default: 50 }
+        - name: cursor
+          in: query
+          schema: { type: string }
+      responses:
+        '200':
+          description: Owed replies for the caller, oldest-waiting first
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  items:
+                    type: array
+                    items:
+                      type: object
+                      properties:
+                        id: { type: string }
+                        kind: { type: string, enum: [request, mention, dm, review_requested, handoff] }
+                        roomId: { type: string }
+                        actor: { type: [string, "null"] }
+                        title: { type: string }
+                        state: { type: string, enum: [unread, read] }
+                        createdAt: { type: string, format: date-time }
+                        updatedAt: { type: string, format: date-time }
+                        waitingMs: { type: integer, minimum: 0 }
+                        where:
+                          type: object
+                          properties:
+                            roomId: { type: string }
+                            messageId: { type: string }
+                            requestId: { type: string }
+                            workItemId: { type: string }
+                        next: { type: object }
+                        basisToken:
+                          type: string
+                          pattern: '^ub1_[a-f0-9]{64}$'
+                  hasMore: { type: boolean }
+                  cursor: { type: [string, "null"] }
+                  limit: { type: integer }
+                  untrusted: { type: boolean }
+        '401': { description: unauthenticated }
+        '422': { description: invalid_owed_query or invalid_cursor }
+        '429': { description: rate_limited }
   /api/rooms/{roomId}/updates:
     get:
       summary: What needs this member in one room
