{
  // Production Worker config. No Clerk secrets in git.
  // wrangler secret put ROOM_CLERK_ISSUER / PUBLISHABLE_KEY / PUBLIC_KEY
  // wrangler secret put ROOM_OPERATOR_ACCOUNT_ID
  "name": "project-room",
  "main": "room.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node ../scripts/stamp-version.mjs && node build-assets.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ProjectRoom" }] },
  "migrations": [{ "tag": "room-sqlite-v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "vars": {
    "ROOM_ORIGIN": "https://room.trydemigod.com",
    "ROOM_PRODUCTION": "1"
  },
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false }
}
