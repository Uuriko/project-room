{
  "name": "project-room-external-probe",
  "main": "external-probe-worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  // Replace this placeholder before deploy. The all-zero id is not a namespace.
  // Until PROBE_STATE is a real KV namespace, the Worker does not notify.
  "kv_namespaces": [
    { "binding": "PROBE_STATE", "id": "00000000000000000000000000000000" }
  ],
  "vars": { "PROBE_ORIGIN": "https://room.trydemigod.com" }
}
