+    if (members?.[target.owner]?.kind !== "agent") continue;
+    const touched = paths.length ? `It changed ${paths.slice(0, 8).map(plain).join(", ")}${paths.length > 8 ? ` and ${paths.length - 8} more` : ""}.` : "Its changed files are not on the claim.";
