+    try {
+      postAlert(store, roomId, { material, body, memberIds: [target.owner], members });
+      sent.push(material);
+    } catch (error) {
+      console.error("concurrent merge notice failed:", error?.message ?? error);
+    }
+  }
+  return sent;
+}
