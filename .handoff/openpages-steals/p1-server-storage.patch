diff --git a/server/workspace-context.mjs b/server/workspace-context.mjs
new file mode 100644
index 00000000..cad55234
--- /dev/null
+++ b/server/workspace-context.mjs
@@ -0,0 +1,150 @@
+// Query-aware workspace context (OpenPages-style "workspace_context").
+//
+// Pure: given the messages and text files a member can already read, score
+// every line against the query with BM25 and keep the best lines (plus one
+// neighbor each side) inside a token budget. Lines keep their original
+// wording and order inside each source; nothing is summarized, and nothing is
+// dropped by position (no head/tail truncation). The query itself is never
+// compressed. The caller owns authorization and visibility.
+
+export const WORKSPACE_CONTEXT_POLICY = "bm25-line-keep-v1";
+export const WORKSPACE_CONTEXT_DEFAULT_TOKENS = 2000;
+export const WORKSPACE_CONTEXT_MAX_TOKENS = 8000;
+export const WORKSPACE_CONTEXT_MIN_TOKENS = 200;
+export const MAX_QUERY_CHARS = 500;
+
+const STOPWORDS = new Set(("a an and are as at be but by can do does for from has have how i if in is it its " +
+  "me my of on or our so that the their them then there these they this to us was we were what when where " +
+  "which who why will with you your").split(" "));
+
+export const roughTokens = text => Math.ceil(String(text ?? "").length / 4);
+
+export function queryTerms(query) {
+  const seen = new Set();
+  for (const term of String(query ?? "").toLowerCase().match(/[\p{L}\p{N}_]+/gu) ?? []) {
+    if (term.length < 2 || STOPWORDS.has(term)) continue;
+    seen.add(term);
+  }
+  return [...seen];
+}
+
+const lineTerms = line => (line.toLowerCase().match(/[\p{L}\p{N}_]+/gu) ?? []);
+
+// sources: [{ kind, id, title, authorId?, createdAt?, text }]
+export function buildWorkspaceContext({ sources, query, maxTokens = WORKSPACE_CONTEXT_DEFAULT_TOKENS }) {
+  const terms = queryTerms(query);
+  if (!terms.length) throw new RangeError("query needs at least one word");
+  const budget = Math.min(WORKSPACE_CONTEXT_MAX_TOKENS, Math.max(WORKSPACE_CONTEXT_MIN_TOKENS, Math.floor(maxTokens)));
+  const phrase = String(query).trim().toLowerCase();
+
+  const units = [];
+  const prepared = sources.map((source, sourceIndex) => {
+    const lines = String(source.text ?? "").split(/\r?\n/);
+    const rows = lines.map((line, lineIndex) => {
+      const words = lineTerms(line);
+      const unit = { sourceIndex, lineIndex, line, words, length: words.length, score: 0 };
+      if (line.trim()) units.push(unit);
+      return unit;
+    });
+    return { ...source, rows };
+  });
+  const originalTokens = prepared.reduce((sum, source) => sum + roughTokens(source.text), 0);
+
+  // BM25 over lines.
+  const k1 = 1.2;
+  const b = 0.75;
+  const n = units.length || 1;
+  const avg = units.reduce((sum, unit) => sum + unit.length, 0) / n || 1;
+  const df = new Map(terms.map(term => [term, 0]));
+  for (const unit of units) {
+    const present = new Set(unit.words);
+    for (const term of terms) if (present.has(term)) df.set(term, df.get(term) + 1);
+  }
+  for (const unit of units) {
+    let score = 0;
+    for (const term of terms) {
+      const tf = unit.words.reduce((count, word) => count + (word === term), 0);
+      if (!tf) continue;
+      const idf = Math.log(1 + (n - df.get(term) + 0.5) / (df.get(term) + 0.5));
+      score += idf * (tf * (k1 + 1)) / (tf + k1 * (1 - b + b * unit.length / avg));
+    }
+    if (score > 0 && phrase.length >= 4 && unit.line.toLowerCase().includes(phrase)) score *= 1.5;
+    unit.score = score;
+  }
+
+  const ranked = units.filter(unit => unit.score > 0)
+    .sort((a, b2) => b2.score - a.score || a.sourceIndex - b2.sourceIndex || a.lineIndex - b2.lineIndex);
+  const kept = new Set();
+  const key = (s, l) => `${s}:${l}`;
+  let used = 0;
+  const headerCost = new Map();
+  const take = (sourceIndex, lineIndex) => {
+    const row = prepared[sourceIndex].rows[lineIndex];
+    if (!row || !row.line.trim() || kept.has(key(sourceIndex, lineIndex))) return true;
+    const header = headerCost.has(sourceIndex) ? 0 : roughTokens(sourceHeader(prepared[sourceIndex])) + 1;
+    const cost = roughTokens(row.line) + 1 + header;
+    if (used + cost > budget) return false;
+    used += cost;
+    headerCost.set(sourceIndex, header);
+    kept.add(key(sourceIndex, lineIndex));
+    return true;
+  };
+  for (const unit of ranked) {
+    if (!take(unit.sourceIndex, unit.lineIndex)) continue;
+    take(unit.sourceIndex, unit.lineIndex - 1);
+    take(unit.sourceIndex, unit.lineIndex + 1);
+  }
+
+  const best = new Map();
+  for (const unit of ranked) if (!best.has(unit.sourceIndex)) best.set(unit.sourceIndex, unit.score);
+  const order = [...best.keys()].filter(index => headerCost.has(index))
+    .sort((a, b2) => best.get(b2) - best.get(a) || a - b2);
+  const blocks = [];
+  const summary = [];
+  for (const sourceIndex of order) {
+    const source = prepared[sourceIndex];
+    const lines = [];
+    let last = -2;
+    let linesKept = 0;
+    for (const row of source.rows) {
+      if (!kept.has(key(sourceIndex, row.lineIndex))) continue;
+      if (last >= 0 && row.lineIndex > last + 1) lines.push("…");
+      lines.push(row.line);
+      last = row.lineIndex;
+      linesKept += 1;
+    }
+    blocks.push(`${sourceHeader(source)}\n${lines.join("\n")}`);
+    summary.push({
+      kind: source.kind, id: source.id, title: source.title ?? null,
+      authorId: source.authorId ?? null, createdAt: source.createdAt ?? null,
+      linesIn: source.rows.filter(row => row.line.trim()).length, linesKept,
+      score: Math.round(best.get(sourceIndex) * 1000) / 1000
+    });
+  }
+  const context = blocks.join("\n\n");
+  const keptTokens = roughTokens(context);
+  return {
+    policy: WORKSPACE_CONTEXT_POLICY,
+    query: String(query),
+    terms,
+    budgetTokens: budget,
+    candidates: prepared.length,
+    matched: best.size,
+    omittedMatches: best.size - order.length,
+    originalTokens,
+    keptTokens,
+    tokensSavedPct: originalTokens ? Math.round(Math.max(0, 1 - keptTokens / originalTokens) * 1000) / 10 : 0,
+    sources: summary,
+    context
+  };
+}
+
+export function sourceHeader(source) {
+  if (source.kind === "file") return `### File: ${source.title ?? source.id} (id ${source.id})`;
+  const who = source.authorName ?? source.authorId ?? "unknown";
+  return `### Message ${source.id} from ${who}${source.createdAt ? ` at ${source.createdAt}` : ""}`;
+}
+
+const TEXT_TYPES = new Set(["application/json", "application/xml", "application/x-yaml", "application/yaml",
+  "application/toml", "application/javascript", "application/x-ndjson", "application/sql"]);
+export const isTextMediaType = type => typeof type === "string" && (type.startsWith("text/") || TEXT_TYPES.has(type) || type.endsWith("+json") || type.endsWith("+xml"));
