diff --git a/src/app.js b/src/app.js
index b07ebb9a..6caca937 100644
--- a/src/app.js
+++ b/src/app.js
@@ -4829,6 +4829,32 @@ $("#room-overview-open").addEventListener("click", () => {
   $("#room-overview-dialog").showModal();
   renderRoomOverview();
 });
+// "What agents see": the same query-aware context room_workspace_context
+// hands an agent, so a person can check what was kept and what was cut.
+let agentViewFlight = 0;
+$("#agent-view-form").addEventListener("submit", async event => {
+  event.preventDefault();
+  const query = $("#agent-view-query").value.trim();
+  if (!state || !query) return;
+  const flight = ++agentViewFlight;
+  const out = $("#agent-view-result");
+  out.textContent = "Looking…";
+  try {
+    const view = await client.roomRead(`/workspace-context?q=${encodeURIComponent(query)}`);
+    if (flight !== agentViewFlight || !view) return;
+    if (!view.matched) { out.innerHTML = `<p class="form-hint">Nothing in this room matches that yet.</p>`; return; }
+    const link = (kind, id, title, key) => `<a href="${esc(recordHref(kind, id))}" data-open-${kind}="${esc(id)}" data-focus-key="overview:${esc(key)}">${esc(title)}</a>`;
+    const source = item => item.kind === "file"
+      ? `<li>📄 ${esc(item.title ?? item.id)} <span class="form-hint">${item.linesKept}/${item.linesIn} lines</span></li>`
+      : `<li>${link("message", item.id, memberLabel(item.authorId), `agent-view:${item.id}`)} <span class="form-hint">${item.linesKept}/${item.linesIn} lines</span></li>`;
+    out.innerHTML = `<p class="agent-view-stat">${esc(String(view.keptTokens))} of ${esc(String(view.originalTokens))} tokens</p>`
+      + `<p class="form-hint">${esc(String(view.tokensSavedPct))}% cut · ${view.sources.length} ${view.sources.length === 1 ? "source" : "sources"}</p>`
+      + `<ul>${view.sources.map(source).join("")}</ul>`
+      + `<details><summary>Exact text</summary><pre>${esc(view.context)}</pre></details>`;
+  } catch (error) {
+    if (flight === agentViewFlight) out.innerHTML = `<p class="form-hint">${esc(error.message || "Could not load that.")}</p>`;
+  }
+});
 $("#room-overview-close").addEventListener("click", () => {
   $("#room-overview-dialog").close();
   $("#room-overview-open").focus({ preventScroll: true });
