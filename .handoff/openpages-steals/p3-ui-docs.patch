+  /api/rooms/{roomId}/files/{id}/history:
+    get:
+      summary: Read a room file's version history
+      description: |
+        Returns the version chain (oldest first) that the file id belongs to,
+        with who staged each version (human or agent), via mcp or http, and
+        the current head. Versions the caller cannot see are listed as hidden.
+      parameters:
+        - $ref: '#/components/parameters/RoomId'
+        - name: id
+          in: path
+          required: true
+          schema: { type: string }
+      responses:
+        '200':
+          description: Version chain
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  roomId: { type: string }
+                  id: { type: string }
+                  head: { type: string }
+                  count: { type: integer }
+                  versions: { type: array, items: { type: object } }
+        '401':
+          description: No room credential
+        '404':
+          description: File not found
+  /api/rooms/{roomId}/files/{id}/restore:
+    post:
+      summary: Restore an older room file version
+      description: |
+        Stages the bytes of an older version as a new version on top of the
+        current head. The restored version is staged and private to the caller
+        until committed onto a message.
+      parameters:
+        - $ref: '#/components/parameters/RoomId'
+        - name: id
+          in: path
+          required: true
+          schema: { type: string, description: The older version to restore }
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              required: [id]
+              properties:
+                id: { type: string, description: New file id for the restored version }
+      responses:
+        '201':
+          description: Restored version staged
+        '401':
+          description: No room credential
+        '404':
+          description: File not found
+        '409':
+          description: Version is already the head, or the chain changed
+        '410':
+          description: The version's bytes are no longer stored
+  /api/rooms/{roomId}/workspace-context:
+    get:
+      summary: Read the exact context an agent would get for a query
+      description: |
+        Ranks visible message lines and committed text files against q with
+        BM25, keeps the best lines plus one neighbor in original order within
+        maxTokens, and never truncates by position. Returns the exact text,
+        per-source line counts, and the token budget math.
+      parameters:
+        - $ref: '#/components/parameters/RoomId'
+        - name: q
+          in: query
+          required: false
+          schema: { type: string, maxLength: 500 }
+        - name: maxTokens
+          in: query
+          required: false
+          schema: { type: integer, minimum: 200, maximum: 8000, default: 2000 }
+      responses:
+        '200':
+          description: Workspace context
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  roomId: { type: string }
+                  policy: { type: string }
+                  budgetTokens: { type: integer }
+                  originalTokens: { type: integer }
+                  keptTokens: { type: integer }
+                  tokensSavedPct: { type: number }
+                  sources: { type: array, items: { type: object } }
+                  context: { type: string }
+        '401':
+          description: No room credential
   /api/web/fetch:
