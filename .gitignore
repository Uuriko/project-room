node_modules
.data/
*.sqlite
*.sqlite-*
.env
.env.*
!.env.example
coverage/
test-results/

# Local run logs (may contain tokens) — never commit
runlogs-tmp/

# RC-2026-09-18-051: local test TMPDIR (never commit test scratch)
.tmp/

# Expanded at import time by scripts/acceptance-fixture.mjs
scripts/.acceptance-fixture.*.generated.mjs
tests/.webhook-dispatch-store.*.generated.mjs
tests/.telegram-webhook-rotation.*.generated.mjs
# Expanded at import time by browser-check loaders (flood-guard clock seeds)
scripts/.browser-check.*.generated.mjs
scripts/.native-result-browser-check.*.generated.mjs
scripts/.reconnect-collaboration-browser-check.*.generated.mjs
scripts/.notification-feed-browser-check.*.generated.mjs
scripts/.help-invitation-browser-check.*.generated.mjs
# PRODUCT-200 C2 chaos properties: guard-weakened copies of work-claims.mjs,
# generated at test time by tests/chaos/loadWeakenedClaimModule.
tests/chaos/.weak/

# Invariant harness CI results (per-run JSONL, INVARIANTS telemetry contract)
results/

# FIX-27 credential hygiene: agent identities and secret material are
# gitignored from commit zero — never `git add -A` them into history.
# Narrow on purpose: code/test files with "token"/"secret" in the name
# (token-bucket.mjs, secret-scan.mjs, design-tokens-baseline.json) must NOT match.
identity.json
identity-*.json
*-identity.json
*credential*.json
*credential*.txt
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.token
token.json
token.txt
*-token.json
*-token.txt
*_token.json
*_token.txt
