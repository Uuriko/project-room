node_modules
.data/
*.sqlite
*.sqlite-*
.env
.env.*
!.env.example
coverage/
test-results/

# Local run logs (may contain tokens) — never commit
runlogs-tmp/

# Candidate manifest is generated, never committed (CH-1): CI builds it from
# the tree and uploads it as a run artifact; freeze prep generates it locally
# with `node scripts/candidate-manifest.mjs --write`.
scripts/CANDIDATE-MANIFEST.json

# RC-2026-09-18-051: local test TMPDIR (never commit test scratch)
.tmp/

# Test-generated modules, expanded at import time by test fixtures and
# browser-check loaders (acceptance fixtures, webhook-dispatch stores,
# flood-guard clock seeds, ...). One generalized pattern per directory —
# the previous per-test-name allowlist leaked every new generating test
# as an untracked file in every worktree (HK2 §C.3).
scripts/.*.generated.mjs
tests/.*.generated.mjs

# Local QA scratch directories and verify-affected logs (never commit)
qa-scratch*/
verify-affected.log
# PRODUCT-200 C2 chaos properties: guard-weakened copies of work-claims.mjs,
# generated at test time by tests/chaos/loadWeakenedClaimModule.
tests/chaos/.weak/

# Invariant harness CI results (per-run JSONL, INVARIANTS telemetry contract)
results/

# Generated outputs — built on demand / in CI, never committed (docs corpus
# rule: a file whose first line names its generator is a CI artifact)
docs/SERVER-COVERAGE.md
docs/OPENAPI-CONTRACT-REPORT.md
docs/room-health.html
# Agent pages — built by scripts/build-agent-docs.mjs at CF deploy time
# (decision #36 / #3254 Option A: never committed, never in the runtime package)
docs/agents/*.html
