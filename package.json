{
  "name": "project-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "room": "bin/room.mjs"
  },
  "description": "Executable v0 contract for a shared human and agent project room",
  "scripts": {
    "start": "node server.mjs",
    "pretest": "node scripts/verify-preflight.mjs && node scripts/build-agent-docs.mjs",
    "test": "node --test",
    "verify:affected": "node scripts/verify-affected.mjs",
    "test:quarantined": "node scripts/run-quarantined-tests.mjs",
    "test:relay": "npm --prefix relay test",
    "test:refine": "node --test scripts/refine-draft-browser-check.mjs",
    "test:browser": "node scripts/browser-suites.mjs --run",
    "test:browser:ci": "node scripts/browser-ci.mjs",
    "check": "node scripts/check.mjs",
    "gate": "bash scripts/pre-push.sh",
    "lint": "node scripts/lint.mjs && node scripts/lint-design-tokens.mjs && node scripts/reachability.mjs --check && node scripts/i18n-harness.mjs --check && node scripts/build-ui-strings.mjs --check",
    "build:og-atlas": "node scripts/build-og-atlas.mjs",
    "github-app:check": "node scripts/github-app-check.mjs",
    "analytics:backfill": "node scripts/analytics-backfill.mjs",
    "analytics:bond-shadow": "node scripts/claim-bond-shadow.mjs",
    "analytics:claim-reputation": "node scripts/claim-reputation-sync.mjs",
    "analytics:funnel": "node scripts/an-funnel-1.mjs",
    "analytics:loop-funnel": "node scripts/an-funnel-2.mjs",
    "provision": "node scripts/provision.mjs",
    "audit:invitations": "node scripts/audit-invitations.mjs",
    "test:handoff": "node --test tests/agent-handoff.test.js",
    "build:agent-docs": "node scripts/build-agent-docs.mjs",
    "test:machine": "node --test machine/test/machine.test.mjs",
    "agent:inbox": "node scripts/agent-inbox.mjs",
    "agent:roster": "node scripts/room-roster.mjs",
    "qa3:authz-board": "node scripts/qa3/authz-board.mjs",
    "qa3:content-trust": "node scripts/qa3/content-trust.mjs",
    "qa3:public-scan-budget": "node scripts/qa3/public-scan-budget.mjs",
    "qa3:sse-contract": "node scripts/qa3/sse-contract.mjs",
    "qa3:board-growth": "node scripts/qa3/board-growth.mjs",
    "detect-flaky": "node scripts/flaky-detect.mjs",
    "fuzz:mime": "node scripts/fuzz-mime.mjs",
    "test:contributor": "node --test --test-concurrency=1 scripts/selfhost-onboarding-browser-check.mjs scripts/contribution-journey-check.mjs tests/github-work-sync.test.js tests/claim-autolink-http.test.js",
    "bench:room": "node scripts/bench/compare.mjs",
    "map:local": "node scripts/project-map-local.mjs",
    "map:publish": "node scripts/project-map-publish.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "acorn": "8.18.0",
    "eslint": "10.10.0",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "sanitize-html": "2.18.0",
    "yaml": "^2.8.1"
  },
  "license": "Apache-2.0",
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
