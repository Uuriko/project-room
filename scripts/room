#!/usr/bin/env bash
#
# room — typed CLI for the project-room claims board (Uuriko/project-room#266).
#
# Scheduler/board discipline adapted from rowboatlabs/rowboat
# (https://github.com/rowboatlabs/rowboat), (c) rowboatlabs, licensed under
# the Apache License 2.0. Rowboat's durable-log + stamp-at-write discipline
# (agents write structured claims/receipts; tooling reads the fenced blocks,
# never the prose) is ported here to the GitHub-issues substrate: comments
# are the events, gh REST is the only transport, and docs/ROOM-PROTOCOL.md
# is the protocol's only editable surface.
#
# No servers, no daemons, no config files. Dependencies: bash, gh, jq.
# Board address defaults to Uuriko/project-room#266 (see --repo/--issue).
#
# Exit codes: 0 ok · 2 refused by guard (duplicate-claim) · 1 error.

set -euo pipefail

VERSION="0.1.0"
DEFAULT_REPO="Uuriko/project-room"
DEFAULT_ISSUE="266"
DEFAULT_LANE="quill-s2"

REPO="$DEFAULT_REPO"
ISSUE="$DEFAULT_ISSUE"
DRY_RUN=0

# ---------------------------------------------------------------------------
# small utilities
# ---------------------------------------------------------------------------

die() { printf 'room: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'room: warn: %s\n' "$*" >&2; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 (need bash + gh + jq)"
}

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

trim() {
  # trim leading/trailing whitespace (incl. newlines -> caller decides)
  printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

one_line() {
  # collapse a reason/note to a single line
  printf '%s' "$1" | tr '\n' ' ' | sed -e 's/[[:space:]][[:space:]]*/ /g' -e 's/^[ ]*//' -e 's/[ ]*$//'
}

repo_root() {
  git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD"
}

board_addr() { printf '%s#%s' "$REPO" "$ISSUE"; }

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
room — typed CLI for the claims board (Uuriko/project-room#266)

Global flags (before the verb): --dry-run --repo OWNER/REPO --issue N --help

Agent verbs (post as comments on the board, prefixed [<lane>] + protocol prefix):
  claim     --task-id ID --lane LANE --files f1,f2 --lease Nh --reason "..."
            [--state submitted|working] [--dry-run]
            Post [lane][claim] + room-claim block. Duplicate-claim guard runs
            first: refuses (exit 2) if the task-id is already used, or any of
            the files are claimed live by a different lane. Refusal is posted
            as RECLAIM with stamp <!-- room:duplicate-refusal:<task-id>:<ts> -->.
  heartbeat --task-id ID --lane LANE [--note "..."]
            Post [lane]STATUS: restating the claim block with state: working.
  release   --task-id ID --lane LANE --reason "..."
            Post [lane]STATUS: restating the claim block with state: cancelled.
  query     [--lane LANE] [--status S] [--file F] [--work-for LANE]
            [--state PATH] [--live]
            Read the machine board (default: ROOM-STATE.md at repo root).
            --live rebuilds from the board instead. --work-for answers
            "is there work for me?": submitted-but-unclaimed tasks, leases
            expiring <6h, unclaimed lanes.
  handoff   --task-id ID --from LANE --to LANE --context "..." [--note "..."]
            Post [lane]HANDOFF: with room-handoff block + restated claim block
            naming the receiving lane. (Transfers on ACK, not on post.)
  receipt   --task-id ID --lane LANE --merged SHA|none --note "..."
            Post [lane]DONE: + room-receipt block (24h receipt SLO).

Enforcer verbs (cron-only; sweep/receipts-scan --post write to the board):
  rebuild   [--out PATH] [--commit-push]
            Regenerate the machine board from board comments. Stamps a
            generated header with watermark (max comment id). --commit-push
            commits on branch room-state (from origin/main if missing) and
            pushes; never force-pushes; never touches main.
  sweep     [--dry-run]
            Lease sweep: expired working claims get a RECLAIM strike-one nudge
            (@-mention, 4h grace); strike-two releases the task back to
            submitted with no lane; illegal transitions get a RECLAIM
            rejection notice.
  receipts-scan [--post]
            Completed tasks / merged PRs older than 24h without a room-receipt
            block. --post posts one prose digest comment (no protocol prefix;
            prose changes nothing).
  rotation-check
            board_comments=<n> threshold=1500 rotation_due=yes|no
  metrics   [--since ISO]
            claims_opened/completed/expired, receipts, missing_receipts,
            distinct_lanes, comments_per_day (machine lines).

Internal (fixture/testing): _parse (comments JSON -> events JSON),
_state (events JSON -> state JSON; --now ISO --comments N --watermark ID).

Exit codes: 0 ok, 2 refused-by-guard, 1 error.
Protocol grammar: docs/ROOM-PROTOCOL.md (the normative source).
EOF
}

# ---------------------------------------------------------------------------
# GitHub board I/O (gh REST only; numeric comment ids)
# ---------------------------------------------------------------------------

gh_api() { # args... -> stdout JSON; dies on failure
  gh api "$@" || die "gh api failed: $*"
}

fetch_comments() { # -> JSON array of all comments on the board issue
  gh api --paginate "repos/$REPO/issues/$ISSUE/comments?per_page=100" 2>/dev/null \
    | jq -s 'add // []' \
    || die "failed to fetch board comments from $(board_addr)"
}

comment_count() {
  gh_api "repos/$REPO/issues/$ISSUE" --jq '.comments' 2>/dev/null \
    || die "failed to read issue $(board_addr)"
}

post_comment() { # $1 = body -> prints id/url; dry-run prints body to stdout
  local body="$1"
  if [ "$DRY_RUN" = 1 ]; then
    printf '%s\n' "$body"
    return 0
  fi
  gh_api -X POST "repos/$REPO/issues/$ISSUE/comments" -f body="$body" \
    --jq '"posted comment id=\(.id) url=\(.html_url)"'
}

# ---------------------------------------------------------------------------
# jq: comment -> event parsing
# Parses fenced blocks (room-claim / room-receipt / room-handoff) and the
# status prefixes. [lane][claim] prose without a fenced block is parsed
# conservatively too: backtick-quoted paths (plus files:/claim: lines) and a
# recognizable task-id become a lease-bearing prose-claim (lease=12h);
# anything else surfaces as unleased-prose-claim ("needs fencing"), never
# silently ignored. Fenced claims always win and are byte-for-byte untouched.
# ---------------------------------------------------------------------------

parse_events() { # stdin: comments JSON array -> stdout: events JSON array
  jq '
    def trim: gsub("^[ \t]+|[ \t]+$"; "");

    # first fenced block of type $t, or null
    def fence($t):
      ([capture("```room-" + $t + "[ \t]*\n(?<b>[\\s\\S]*?)\n```")] | .[0] | .b) // null;

    # fenced body -> {field: value}
    def fields:
      split("\n")
      | map(select(test("^[ \t]*[A-Za-z0-9_-]+[ \t]*:")))
      | map(capture("^[ \t]*(?<k>[A-Za-z0-9_-]+)[ \t]*:[ \t]*(?<v>[\\s\\S]*)$")
            | {key: .k, value: (.v | trim)})
      | from_entries;

    def first_rc: ([capture("(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+)")] | .[0] | .t) // null;

    # prose receipt fields: [lane][receipt] A010-2 ... PR #392 ... Merge SHA: <hex>
    def first_task: ([capture("(?<t>[A-Z]+[0-9]*-[0-9]+)")] | .[0] | .t) // null;
    def first_pr:
      (([capture("(?:PR|pull)[ \\t#:/]*#?(?<n>[0-9]+)")] | .[0] | .n)
       // ([capture("project-room#(?<n>[0-9]+)")] | .[0] | .n)) // null;
    def first_sha:
      ([capture("(?<![A-Za-z0-9])[Mm]erge(?:d)?(?: SHA| commit)?[ \\t]*:[ \\t]*(?<s>[0-9a-f]{7,40})(?![A-Za-z0-9])")]
       | .[0] | .s) // null;

    # prose claim parsing: [lane][claim] without a fenced block.
    # Conservative on purpose: only path-shaped tokens become files, and a
    # claim earns a lease only when BOTH files and a recognizable task-id are
    # found. Anything else surfaces as unleased-prose-claim ("needs fencing")
    # so it is visible in the log, state, metrics, and ROOM-STATE.md — never
    # silently ignored. A fenced room-claim block always wins when present.
    def prose_path_ok:
      test("^[A-Za-z0-9_.][A-Za-z0-9_./-]*$")
      and (test("/") or test("\\.[A-Za-z0-9]{1,10}$"))
      and ((test("\\.\\.")) | not);
    def prose_files:
      (([capture("`(?<f>[^`\\r\\n]+)`"; "g")] | map(.f))
       + ([split("\n")[]
           | capture("^[ \\t]*(?:files?|claim(?:ed|s)?)[ \\t]*[:=][ \\t]*(?<rest>[\\s\\S]*)$")
           | .rest
           | [match("[A-Za-z0-9_.][A-Za-z0-9_./-]*"; "g") | .string]]
          | add // []))
      | map(select(prose_path_ok)) | unique;
    def prose_task:
      (([capture("(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+)")] | .[0] | .t)
       // ([capture("(?<t>[A-Z]+[0-9]*-[0-9]+)")] | .[0] | .t)
       // null);
    def prose_reason:
      gsub("[ \\t][ \\t]+"; " ") | gsub("\\n"; " ")
      | .[0:280] | gsub("^[ \\t]+|[ \\t]+$"; "");
    def prose_claim($lane):
      . as $b
      | ($b | prose_files) as $files
      | ($b | prose_task) as $task
      | if ($files | length) > 0 and $task != null then
          {kind:"prose-claim", task_id:$task, lane:$lane, files:$files,
           reason:(("prose claim: " + ($b | prose_reason)) | .[0:300])}
        else
          {kind:"unleased-prose-claim", lane:$lane, task:$task, files:$files}
        end;

    def parse_comment:
      (.body | gsub("\r"; "")) as $body
      | (.id) as $id | (.created_at) as $at
      | ($body | split("\n")[0]) as $first
      | (($first | capture("^\\[(?<lane>[A-Za-z0-9_-]+)\\](?<rest>[\\s\\S]*)$"))
         // {lane: null, rest: $first}) as $lp
      | ($lp.rest | gsub("^[ \t]+"; "")) as $rest
      | (($rest | capture("^(?<p>\\[claim\\]|\\[receipt\\]|STATUS:|DONE:|HANDOFF:|RECLAIM)(?<tail>[\\s\\S]*)$"))
         // {p: null, tail: $rest}) as $pf
      | ($body | fence("claim")) as $fclaim
      | ($body | fence("receipt")) as $frcpt
      | ($body | fence("handoff")) as $fhand
      | (if $pf.p == "[claim]" then
           if $fclaim then {kind:"claim", block:($fclaim|fields)}
           else ($body | prose_claim($lp.lane)) end
         elif $pf.p == "[receipt]" then
           {kind:"receipt",
            task:($pf.tail | first_task),
            pr:($body | first_pr),
            merged:($body | first_sha),
            ref:($pf.tail | first_rc),
            receipt:(if $frcpt then ($frcpt|fields) else null end)}
         elif $pf.p == "STATUS:" then
           (if ($pf.tail | test("^[ \t]*ACK[ \t]+RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+")) then
              {ack:true, ack_task:(($pf.tail | first_rc))}
            else {ack:false, ack_task:null} end) as $a
           | if $fclaim then {kind:"status", block:($fclaim|fields), ack:$a.ack, ack_task:$a.ack_task}
             elif $a.ack then {kind:"ack", ack_task:$a.ack_task}
             else {kind:"malformed", want:"room-claim"} end
         elif $pf.p == "DONE:" then
           {kind:"done", ref:($pf.tail | first_rc),
            receipt:(if $frcpt then ($frcpt|fields) else null end)}
         elif $pf.p == "HANDOFF:" then
           {kind:"handoff",
            hblock:(if $fhand then ($fhand|fields) else null end),
            cblock:(if $fclaim then ($fclaim|fields) else null end)}
         elif $pf.p == "RECLAIM" then
           {kind:"reclaim",
            strike_one:  (($body | [capture("<!--[ \t]*room:strike-one:(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+):(?<ts>[^> \t]+)[ \t]*-->")] | .[0]) // null),
            strike_two:  (($body | [capture("<!--[ \t]*room:strike-two:(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+):(?<ts>[^> \t]+)[ \t]*-->")] | .[0]) // null),
            dup_refusal: (($body | [capture("<!--[ \t]*room:duplicate-refusal:(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+):(?<ts>[^> \t]+)[ \t]*-->")] | .[0]) // null),
            illegal_rej: (($body | [capture("<!--[ \t]*room:illegal-rejection:(?<t>RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+):(?<ts>[^> \t]+)[ \t]*-->")] | .[0]) // null)}
         else {kind:"prose"} end) as $ev
      | {id:$id, at:$at, lane:$lp.lane, prefix:$pf.p} + $ev
    ;
    [.[] | parse_comment] | sort_by(.at, .id)
  '
}

# ---------------------------------------------------------------------------
# jq: event -> board state reduction
# ---------------------------------------------------------------------------

reduce_state() { # $1=now_epoch $2=comment_count $3=watermark ; stdin: events -> state
  local now="$1" n="$2" wm="$3"
  jq --argjson now "$now" --argjson meta "{\"comments\": $n, \"watermark\": $wm}" \
     --arg board "$(board_addr)" '
    def trim: gsub("^[ \t]+|[ \t]+$"; "");
    def iso($e): ($e | strftime("%Y-%m-%dT%H:%M:%SZ"));
    def epoch($s): (($s | fromdate) // 0);
    def state_word($s): (($s | capture("^(?<w>[a-z]+)") | .w) // $s);
    def is_live($s): (["submitted","working","suspended"] | index($s)) != null;
    def legal($from; $to):
      ({submitted:["working","cancelled"],
        working:["completed","failed","suspended","cancelled"],
        suspended:["working","cancelled"]}[$from] // []) | index($to) != null;
    def lease_h_of($l): (($l | capture("^lease=(?<n>[0-9]+)h$") | .n | tonumber) // null);
    def lease_exp($t):
      if ($t.lease_h | not) then null
      # Heartbeats renew the lease: expiry extends from the last heartbeat
      # (or claim time if no heartbeat yet). Per John's 2026-09-17 decision:
      # "it needs a heartbeat" means heartbeats keep the lease alive.
      else (epoch($t.heartbeat_at // $t.claim_at) + $t.lease_h * 3600) end;

    def validate_claim($b):
      []
      | (if (($b["task-id"] // "") == "") then . + ["missing task-id"]
         elif (($b["task-id"] | test("^RC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+$")) | not)
           then . + ["task-id not RC-YYYY-MM-DD-NNN"] else . end)
      | (if (($b.lane // "") == "") then . + ["missing lane"] else . end)
      | (if (($b.files // "") == "") then . + ["missing files"]
         elif (($b.files | test("\\*"))) then . + ["files: * forbidden"] else . end)
      | (if (($b.lease // "") == "") then . + ["missing lease"]
         else (($b.lease | capture("^lease=(?<n>[0-9]+)h$") // null) as $m
               | if $m == null then . + ["lease must be lease=<N>h"]
                 elif (($m.n | tonumber) < 1 or ($m.n | tonumber) > 72)
                   then . + ["lease out of range 1-72h"]
                 else . end)
           end)
      | (if (($b.state // "") == "") then . + ["missing state"]
         elif (($b.state | test("^(submitted|working|cancelled|suspended|completed|failed\\([A-Za-z0-9_]+\\))$")) | not)
           then . + ["unknown state word: " + $b.state]
         elif $b.state == "failed" then . + ["failed requires a failure code"] else . end)
      | (if (($b.reason // "") == "") then . + ["missing reason"] else . end);

    # handoff ACK: receiving lane posts STATUS: ACK <task-id> within 4h
    def ack_check($e; $at):
      ($e.ack_task // null) as $ackt
      | if ($ackt | not) then .
        elif ((.tasks[$ackt] // null) | not) then .
        elif ((.tasks[$ackt].pending_handoff // null) | not) then .
        elif (.tasks[$ackt].pending_handoff.to == $e.lane)
             and (epoch($at) - epoch(.tasks[$ackt].pending_handoff.at) <= 14400) then
          .tasks[$ackt] |= (.lane = $e.lane | .pending_handoff = null
                            | .heartbeat_at = $at | .last_at = $at)
          | .log += [{id:$e.id, at:$at, kind:"handoff-ack", task_id:$ackt, ok:true, to:$e.lane}]
        else . end;

    (reduce .[] as $e (
      {tasks:{}, log:[], illegal:[], refused:[], noticed:[], lanes:[],
       prose_receipts:[], unleased_prose_claims:[]};
      ($e.id) as $cid | ($e.at) as $at
      | if $e.kind == "claim" then
          ($e.block["task-id"] // null) as $tid
          | if ($tid | not) then
              .log += [{id:$cid, at:$at, kind:"claim", ok:false, errors:["missing task-id"]}]
            elif ((.tasks[$tid] // null) != null) then
              # task-id reuse is refused, always: a task-id never gets a
              # second claimant (protocol §4). The duplicate block is void.
              .refused += [{task_id:$tid, by_lane:$e.lane, colliding:"task-id",
                            holder_lane:(.tasks[$tid].lane // "(released)"),
                            holder_state:.tasks[$tid].state, at:$at, comment_id:$cid}]
              | .log += [{id:$cid, at:$at, kind:"claim", task_id:$tid, ok:false,
                          errors:["duplicate claim refused; task-id already used"]}]
            else ($e.block | validate_claim(.)) as $errs
              | if ($errs | length) > 0 then
                  .log += [{id:$cid, at:$at, kind:"claim", task_id:$tid, ok:false, errors:$errs}]
                else
                  .tasks[$tid] = {
                    task_id:$tid, lane:$e.block.lane,
                    files:(($e.block.files // "") | split(",") | map(trim) | map(select(length > 0))),
                    lease:$e.block.lease, lease_h:lease_h_of($e.block.lease),
                    reason:$e.block.reason, state:$e.block.state,
                    claim_id:$cid, claim_at:$at, last_at:$at, heartbeat_at:null,
                    last_block:$e.block, strike_one_at:null, released_at:null,
                    pending_handoff:null, handoff_voided:false,
                    receipts:[], missing_receipt:false }
                  | .lanes += [$e.block.lane]
                  | .log += [{id:$cid, at:$at, kind:"claim", task_id:$tid, ok:true}]
                end
            end
        elif $e.kind == "status" then
          ($e.block["task-id"] // null) as $tid
          | if ($tid | not) then .log += [{id:$cid, at:$at, kind:"status", ok:false, errors:["missing task-id"]}]
            elif ((.tasks[$tid] // null) | not) then
              .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:false, errors:["unknown task-id"]}]
            else (.tasks[$tid]) as $t
            | ($e.block.state // "") as $ns
            | state_word($ns) as $to | state_word($t.state) as $from
            | if (is_live($from) | not) then
                .illegal += [{task_id:$tid, by_lane:$e.lane, from:$t.state, attempted:$ns, at:$at,
                              comment_id:$cid, reason:"transition from terminal state"}]
                | .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:false,
                            errors:["illegal: " + $t.state + " -> " + $ns]}]
              elif $to == $from then
                if ($to == "failed" and $ns == "failed") then
                  .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:false,
                            errors:["failed requires a failure code"]}]
                elif (lease_exp($t) and (epoch($at) > lease_exp($t)) and ($t.strike_one_at | not)) then
                  # heartbeat after expiry without a strike-one nudge is void (§4)
                  .log += [{id:$cid, at:$at, kind:"heartbeat", task_id:$tid, ok:false,
                            errors:["heartbeat after lease expiry without strike-one: void"]}]
                else
                  .tasks[$tid] |= (.last_block = $e.block | .last_at = $at | .heartbeat_at = $at)
                  | .log += [{id:$cid, at:$at, kind:"heartbeat", task_id:$tid, ok:true}]
                  | ack_check($e; $at)
                end
              elif legal($from; $to) then
                if ($to == "failed" and (($ns | test("^failed\\([A-Za-z0-9_]+\\)$")) | not)) then
                  .illegal += [{task_id:$tid, by_lane:$e.lane, from:$t.state, attempted:$ns, at:$at,
                                comment_id:$cid, reason:"failed without code"}]
                  | .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:false,
                              errors:["failed requires a failure code"]}]
                else
                  .tasks[$tid] |= (.last_block = $e.block | .last_at = $at | .state = $ns
                                   | if $to == "working" then .heartbeat_at = $at else . end)
                  | .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:true, from:$from, to:$to}]
                  | ack_check($e; $at)
                end
              else
                .illegal += [{task_id:$tid, by_lane:$e.lane, from:$t.state, attempted:$ns, at:$at,
                              comment_id:$cid, reason:"illegal transition"}]
                | .log += [{id:$cid, at:$at, kind:"status", task_id:$tid, ok:false,
                            errors:["illegal: " + $t.state + " -> " + $ns]}]
              end
            end
        elif $e.kind == "done" then
          ((($e.receipt // {})["task-id"] // null) // $e.ref) as $tid
          | if ($tid | not) then .log += [{id:$cid, at:$at, kind:"done", ok:false, errors:["no task-id"]}]
            elif ((.tasks[$tid] // null) | not) then
              .log += [{id:$cid, at:$at, kind:"done", task_id:$tid, ok:false, errors:["unknown task-id"]}]
            else (.tasks[$tid]) as $t
            | state_word($t.state) as $from
            | if $from != "working" then
                .illegal += [{task_id:$tid, by_lane:$e.lane, from:$t.state, attempted:"completed", at:$at,
                              comment_id:$cid, reason:"DONE requires working state"}]
                | .log += [{id:$cid, at:$at, kind:"done", task_id:$tid, ok:false,
                            errors:["DONE illegal from " + $t.state]}]
              else
                .tasks[$tid] |= (.state = "completed" | .last_at = $at
                  | if $e.receipt then
                      .receipts += [{merged:($e.receipt.merged // null),
                                    attribution:($e.receipt.attribution // null),
                                    at:$at, comment_id:$cid}]
                    else . end
                  | .missing_receipt = ((.receipts | length) == 0))
                | .log += [{id:$cid, at:$at, kind:"done", task_id:$tid, ok:true,
                            receipt:($e.receipt != null)}]
              end
            end
        elif $e.kind == "receipt" then
          .prose_receipts += [{task:($e.task // "unknown"), lane:$e.lane,
                               pr:($e.pr // null),
                               merged:(($e.receipt // {})["merged"] // $e.merged // "none"),
                               at:$at, comment_id:$cid}]
          | .log += [{id:$cid, at:$at, kind:"receipt", task_id:$e.task, ok:true}]
        elif $e.kind == "handoff" then
          ((($e.hblock // {})["task-id"] // null) // (($e.cblock // {})["task-id"] // null)) as $tid
          | if ($tid | not) then .log += [{id:$cid, at:$at, kind:"handoff", ok:false, errors:["no task-id"]}]
            elif ((.tasks[$tid] // null) | not) then
              .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false, errors:["unknown task-id"]}]
            else (.tasks[$tid]) as $t
            | if (is_live($t.state) | not) then
                .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false, errors:["task not live"]}]
              elif (($e.hblock // null) | not) then
                .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false, errors:["missing room-handoff block"]}]
              elif (($e.hblock.from // "") != $t.lane) then
                .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false, errors:["handoff from != holding lane"]}]
              elif (($e.hblock.to // "") == "") then
                .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false, errors:["missing to lane"]}]
              elif (($e.cblock // null) | not) or (($e.cblock.lane // "") != $e.hblock.to) then
                .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:false,
                          errors:["missing restated claim block naming receiving lane"]}]
              else
                .tasks[$tid] |= (.pending_handoff = {from:$e.hblock.from, to:$e.hblock.to,
                                                     at:$at, comment_id:$cid,
                                                     context:($e.hblock.context // null)}
                                 | .last_at = $at)
                | .lanes += [$e.hblock.from, $e.hblock.to]
                | .log += [{id:$cid, at:$at, kind:"handoff", task_id:$tid, ok:true,
                            from:$e.hblock.from, to:$e.hblock.to}]
              end
            end
        elif $e.kind == "reclaim" then
          (reduce ["strike_one","strike_two","dup_refusal","illegal_rej"][] as $k (.;
            ($e[$k] // null) as $m
            | if ($m | not) then .
              else ($m.t) as $tid
              | if $k == "strike_one" and ((.tasks[$tid] // null) != null) then
                  .tasks[$tid].strike_one_at = ($m.ts // $at)
                elif $k == "strike_two" and ((.tasks[$tid] // null) != null) then
                  .tasks[$tid] |= (.state = "submitted" | .lane = null | .released_at = $at
                                   | .strike_one_at = null | .last_at = $at | .pending_handoff = null)
                elif $k == "dup_refusal" then
                  .log += [{id:$cid, at:$at, kind:"duplicate-refusal", task_id:$tid, ok:true}]
                elif $k == "illegal_rej" then
                  .noticed += [$tid]
                else . end
              end))
          | .log += [{id:$cid, at:$at, kind:"reclaim", ok:true}]
        elif $e.kind == "prose-claim" then
          # Lease-bearing prose claim: same task-id reuse guard as fenced
          # claims (§4 — a task-id never gets a second claimant), standard
          # 12h lease, state submitted. Marked prose:true so the board can
          # tell it apart from fenced claims.
          ($e.task_id // null) as $tid
          | if ($tid | not) then
              .log += [{id:$cid, at:$at, kind:"prose-claim", ok:false,
                        errors:["missing task-id"]}]
            elif ((.tasks[$tid] // null) != null) then
              .refused += [{task_id:$tid, by_lane:$e.lane, colliding:"task-id",
                            holder_lane:(.tasks[$tid].lane // "(released)"),
                            holder_state:.tasks[$tid].state, at:$at,
                            comment_id:$cid, via:"prose"}]
              | .log += [{id:$cid, at:$at, kind:"prose-claim", task_id:$tid,
                          ok:false,
                          errors:["duplicate claim refused; task-id already used"]}]
            else
              .tasks[$tid] = {
                task_id:$tid, lane:$e.lane,
                files:$e.files, lease:"lease=12h", lease_h:12,
                reason:$e.reason, state:"submitted",
                claim_id:$cid, claim_at:$at, last_at:$at, heartbeat_at:null,
                last_block:({lane:$e.lane, files:($e.files | join(", ")),
                             lease:"lease=12h", state:"submitted",
                             reason:$e.reason, "task-id":$tid, via:"prose"}),
                strike_one_at:null, released_at:null,
                pending_handoff:null, handoff_voided:false,
                receipts:[], missing_receipt:false, prose:true }
              | .lanes += [$e.lane]
              | .log += [{id:$cid, at:$at, kind:"prose-claim", task_id:$tid,
                          ok:true, via:"prose"}]
            end
        elif $e.kind == "unleased-prose-claim" then
          # Visible, not silent: prose claims that could not be fenced into a
          # lease-bearing event are recorded for the "needs fencing" surface.
          .unleased_prose_claims += [{comment_id:$cid, at:$at, lane:$e.lane,
                                      task:($e.task // null)}]
          | .log += [{id:$cid, at:$at, kind:"unleased-prose-claim", ok:false,
                      errors:["needs fencing: no extractable files or task-id"]}]
        elif $e.kind == "ack" then
          ack_check($e; $at)
        else . end
    ))
    # un-ACKed handoffs older than 4h are void: claim stays with handing lane
    | .tasks |= (with_entries(
        if ((.value.pending_handoff // null) != null)
           and (($now | tonumber) - epoch(.value.pending_handoff.at) > 14400) then
          .value |= (.pending_handoff = null | .handoff_voided = true)
        else . end)
      | to_entries
      | map(.value as $v
            | $v + {lease_expires_at:
                (if $v.lease_h
                 then ((epoch($v.claim_at) + $v.lease_h * 3600) | iso(.))
                 else null end)})
      | sort_by(.lease_expires_at // "9999"))
    | .lanes |= unique
    | .noticed |= unique
    | {board:$board, generated_at:iso($now | tonumber),
       comments:$meta.comments, watermark:$meta.watermark,
       tasks:.tasks, illegal:.illegal, refused:.refused,
       noticed:.noticed, lanes:.lanes, log:.log,
       prose_receipts:(.prose_receipts // []),
       unleased_prose_claims:(.unleased_prose_claims // [])}
  '
}

build_state() { # -> state JSON on stdout (live board)
  local comments now n wm
  comments="$(fetch_comments)"
  now="$(date +%s)"
  n="$(printf '%s' "$comments" | jq 'length')"
  wm="$(printf '%s' "$comments" | jq 'map(.id) | max // 0')"
  printf '%s' "$comments" | parse_events | reduce_state "$now" "$n" "$wm"
}

# ---------------------------------------------------------------------------
# jq: state -> ROOM-STATE.md (machine board)
# ---------------------------------------------------------------------------

render_md() { # $1=now_epoch $2=registry_json $3=watcher_state ; stdin: state JSON -> markdown
  local now="$1" reg="$2" watcher="${3:-active}"
  jq -r --argjson now "$now" --arg board "$(board_addr)" --argjson reg "$reg" --arg watcher "$watcher" '
    def iso($e): ($e | strftime("%Y-%m-%dT%H:%M:%SZ"));
    def epoch($s): (($s | fromdate) // 0);
    def is_live($s): (["submitted","working","suspended"] | index($s)) != null;
    def row($t): "\($t.task_id) | \($t.lane // "(none)")\(if $t.prose then " (prose)" else "" end) | \($t.state) | \($t.lease_expires_at // "-") | \($t.files | join(", "))";

    ($now | tonumber) as $now
    | ([.tasks[] | select(is_live(.state))]) as $open_all
    | ([.tasks[] | select(.prose and is_live(.state))]) as $popen
    | ([.unleased_prose_claims[]
        | "\(.comment_id) | \(.lane // "(none)") | \(.task // "-") | \(.at)"]
       | reverse | .[0:10]) as $frows
    | ((.unleased_prose_claims | length) - 10) as $frest
    | ($open_all | sort_by(.lease_expires_at // "9999")) as $open
    | ($open | map(select(.state == "working" and .lease_expires_at
                    and ($now < epoch(.lease_expires_at))
                    and (epoch(.lease_expires_at) - $now < 21600)))) as $exp
    | ([$open_all[] | .lane] | map(select(. != null)) | unique) as $livelanes
    | ($reg | map(select(.lane as $l | ($livelanes | index($l)) | not))) as $unclaimed
    | ([.tasks[] | .task_id as $t | .receipts[] | {task_id:$t, merged:(.merged // "none"), comment_id}]
       + [.prose_receipts[] | {task_id:.task, merged:(.merged // "none"), comment_id}]
       | sort_by(.comment_id) | reverse | .[0:10]) as $rcpts
    | ($open | .[0:25] | map(row(.))) as $orows
    | (($open | length) - 25) as $orest
    | ($exp | map(row(.))) as $erows
    | ($unclaimed | map("\(.lane) | \(.focus) | \(.trust)")) as $urows
    | ($rcpts | map("\(.task_id) | \(.merged) | \(.comment_id)")) as $rrows
    | (if .comments >= 1500 then "yes" else "no" end) as $rot
    | ["# ROOM-STATE — machine board",
      "<!-- generated: \(.generated_at) · board: \($board) · watermark: \(.watermark) · by: scripts/room rebuild · do-not-hand-edit -->",
      "",
      "## open",
      "task-id | lane | state | lease-expires-utc | files",
      ($orows | join("\n")),
      (if $orest > 0 then "… +\($orest) more" else empty end),
      (if ($orows | length) == 0 then "(none)" else empty end),
      "",
      "## expiring-soon (<6h)",
      "task-id | lane | state | lease-expires-utc | files",
      (if ($erows | length) == 0 then "(none)" else ($erows | join("\n")) end),
      "",
      "## unclaimed-lanes",
      "lane | focus | trust",
      (if ($urows | length) == 0 then "(none)" else ($urows | join("\n")) end),
      "",
      "## recent-receipts",
      "task-id | merged | comment-id",
      (if ($rrows | length) == 0 then "(none)" else ($rrows | join("\n")) end),
      "",
      "## prose-claims-needing-fence",
      "comment-id | lane | task | at",
      (if ($frows | length) == 0 then "(none)" else ($frows | join("\n")) end),
      (if $frest > 0 then "… +\($frest) more" else empty end),
      "",
      "## signals",
      "board_comments=\(.comments) threshold=1500 rotation_due=\($rot) watcher=\($watcher) open_claims=\($open_all | length) prose_open=\($popen | length) unfenced_prose=\(.unleased_prose_claims | length) watermark=\(.watermark)"]
    | join("\n") + "\n"
  '
}

registry_json() { # lanes/REGISTRY.md -> [{lane,focus,trust}]
  local f
  f="$(repo_root)/lanes/REGISTRY.md"
  if [ ! -f "$f" ]; then echo '[]'; return 0; fi
  awk -F'|' '/^\|/ && $0 !~ /---/ && $2 !~ /^[ \t]*Lane[ \t]*$/ {
      lane=$2; focus=$4; trust=$5;
      gsub(/^[ \t]+|[ \t]+$/, "", lane);
      gsub(/^[ \t]+|[ \t]+$/, "", focus);
      gsub(/^[ \t]+|[ \t]+$/, "", trust);
      if (lane != "") print lane "\t" focus "\t" trust
    }' "$f" \
    | jq -R -s '[split("\n")[] | select(length > 0) | split("\t") | {lane:.[0], focus:.[1], trust:.[2]}]'
}

# ---------------------------------------------------------------------------
# comment body builders (exact protocol grammars from docs/ROOM-PROTOCOL.md)
# ---------------------------------------------------------------------------

attribution() { # $1 = lane, $2 = mode(agent|scheduled|direct)
  printf '(%s, %s, quill)' "$1" "$2"
}

claim_block_text() { # task lane files lease state reason
  printf '```room-claim\ntask-id:    %s\nlane:       %s\nfiles:      %s\nlease:      %s\nstate:      %s\nreason:     %s\n```\n' \
    "$1" "$2" "$3" "$4" "$5" "$6"
}

receipt_block_text() { # task merged attribution
  printf '```room-receipt\ntask-id:      %s\nmerged:       %s\nattribution:  %s\n```\n' \
    "$1" "$2" "$3"
}

handoff_block_text() { # task from to state_at_handoff context reason
  printf '```room-handoff\ntask-id:          %s\nfrom:             %s\nto:               %s\nstate-at-handoff: %s\ncontext:          %s\nreason:           %s\n```\n' \
    "$1" "$2" "$3" "$4" "$5" "$6"
}

suffix_line() { # task lane
  printf '· claim:%s · lane:%s' "$1" "$2"
}

latest_block() { # $1 = task-id -> prints "lane|files|lease|state|reason" or dies
  local task="$1" st blk
  st="$(build_state)"
  blk="$(printf '%s' "$st" | jq -r --arg t "$task" '
    (.tasks[] | select(.task_id == $t) | .last_block) // empty
    | "\(.lane)|\(.files // "")|\(.lease // "")|\(.state // "")|\(.reason // "")"')"
  [ -n "$blk" ] || die "no claim block found on the board for task-id $task"
  printf '%s' "$blk"
}

# ---------------------------------------------------------------------------
# agent verbs
# ---------------------------------------------------------------------------

cmd_claim() {
  local task="" lane="$DEFAULT_LANE" files="" lease="" reason="" state="submitted" title=""
  while [ $# -gt 0 ]; do case "$1" in
    --task-id) task="$2"; shift 2 ;;
    --lane)    lane="$2"; shift 2 ;;
    --files)   files="$2"; shift 2 ;;
    --lease)   lease="$2"; shift 2 ;;
    --reason)  reason="$2"; shift 2 ;;
    --state)   state="$2"; shift 2 ;;
    --title)   title="$2"; shift 2 ;;
    *) die "claim: unknown flag $1" ;;
  esac; done
  [ -n "$task" ]   || die "claim: --task-id required"
  [ -n "$files" ]  || die "claim: --files required"
  [ -n "$lease" ]  || die "claim: --lease required"
  [ -n "$reason" ] || die "claim: --reason required"
  case "$task" in
    RC-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9]*) ;;
    *) die "claim: --task-id must match RC-YYYY-MM-DD-NNN" ;;
  esac
  case "$state" in submitted|working) ;; *) die "claim: --state must be submitted|working" ;; esac
  case "$files" in *\**) die "claim: files: '*' is forbidden" ;; esac
  local lease_n="${lease%h}"
  case "$lease_n" in ''|*[!0-9]*) die "claim: --lease must be Nh (1-72)" ;; esac
  [ "$lease_n" -ge 1 ] && [ "$lease_n" -le 72 ] || die "claim: --lease out of range 1-72h"
  local lease_s="lease=${lease_n}h"
  reason="$(one_line "$reason")"
  [ -n "$reason" ] || die "claim: --reason must be non-empty"
  files="$(printf '%s' "$files" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | paste -sd, -)"
  [ -n "$files" ] || die "claim: --files resolved empty"
  [ -n "$title" ] || title="claim $task"

  # ---- duplicate-claim guard (fail-closed) ----
  local st holder collide
  st="$(build_state)"
  holder="$(printf '%s' "$st" | jq -r --arg t "$task" '
    [.tasks[] | select(.task_id == $t)] | .[0] // empty
    | "\(.lane // "(released)")|\(.state)"')"
  collide="$(printf '%s' "$st" | jq -r --arg lane "$lane" --arg fs "$files" '
    [ .tasks[]
      | select((.state as $s | (["submitted","working","suspended"] | index($s)) != null)
              and .lane != $lane)
      | .task_id as $t | .lane as $l
      | (.files[] as $f
         | select(("|" + $fs + "|") | contains("|" + $f + "|"))
         | "\($t)|\($l)|\($f)")
    ] | join("\n")')"
  if [ -n "$holder" ] || [ -n "$collide" ]; then
    local iso refusal other_ids
    iso="$(iso_now)"
    other_ids="$(printf '%s\n' "$collide" | cut -d'|' -f1 | sort -u | paste -sd, -)"
    refusal="[$lane]RECLAIM (duplicate refusal): claim $task refused. $(attribution "$lane" agent)"
    refusal="$refusal
"
    if [ -n "$holder" ]; then
      refusal="${refusal}Task-id $task is already used on the board (lane ${holder%%|*}, state ${holder##*|}): a task-id never gets a second claimant."
    fi
    if [ -n "$collide" ]; then
      local cfiles
      cfiles="$(printf '%s\n' "$collide" | cut -d'|' -f3 | sort -u | paste -sd, -)"
      refusal="${refusal}
Colliding files claimed live by another lane: $cfiles (task ${other_ids})."
    fi
    refusal="${refusal}
The duplicate claim block is void; no silent overwrite.

<!-- room:duplicate-refusal:${task}:${iso} -->

$(suffix_line "$task" "$lane")"
    printf '%s\n' "$refusal" >&2
    if [ "$DRY_RUN" != 1 ]; then
      post_comment "$refusal" >/dev/null
    fi
    exit 2
  fi

  local body
  body="[$lane][claim] $title $(attribution "$lane" agent)

$(claim_block_text "$task" "$lane" "$files" "$lease_s" "$state" "$reason")

$(suffix_line "$task" "$lane")"
  post_comment "$body"
}

cmd_heartbeat() {
  local task="" lane="$DEFAULT_LANE" note=""
  while [ $# -gt 0 ]; do case "$1" in
    --task-id) task="$2"; shift 2 ;;
    --lane)    lane="$2"; shift 2 ;;
    --note)    note="$2"; shift 2 ;;
    *) die "heartbeat: unknown flag $1" ;;
  esac; done
  [ -n "$task" ] || die "heartbeat: --task-id required"
  local blk blane bfiles blease _bstate breason
  IFS='|' read -r blane bfiles blease _bstate breason <<EOF
$(latest_block "$task")
EOF
  [ "$blane" = "$lane" ] || warn "heartbeat: holding lane is $blane, posting as $lane"
  note="$(one_line "$note")"
  local headline="heartbeat $task — still working"
  [ -n "$note" ] && headline="$headline: $note"
  local body
  body="[$lane]STATUS: $headline $(attribution "$lane" agent)

$(claim_block_text "$task" "$lane" "$bfiles" "$blease" "working" "$breason")

$(suffix_line "$task" "$lane")"
  post_comment "$body"
}

cmd_release() {
  local task="" lane="$DEFAULT_LANE" reason=""
  while [ $# -gt 0 ]; do case "$1" in
    --task-id) task="$2"; shift 2 ;;
    --lane)    lane="$2"; shift 2 ;;
    --reason)  reason="$2"; shift 2 ;;
    *) die "release: unknown flag $1" ;;
  esac; done
  [ -n "$task" ]   || die "release: --task-id required"
  [ -n "$reason" ] || die "release: --reason required"
  reason="$(one_line "$reason")"
  local blane bfiles blease _bstate breason
  IFS='|' read -r blane bfiles blease _bstate breason <<EOF
$(latest_block "$task")
EOF
  local body
  body="[$lane]STATUS: releasing $task — $reason $(attribution "$lane" agent)

$(claim_block_text "$task" "$lane" "$bfiles" "$blease" "cancelled" "$breason")

$(suffix_line "$task" "$lane")"
  post_comment "$body"
}

cmd_handoff() {
  local task="" from="" to="" context="" note=""
  while [ $# -gt 0 ]; do case "$1" in
    --task-id)  task="$2"; shift 2 ;;
    --from)     from="$2"; shift 2 ;;
    --to)       to="$2"; shift 2 ;;
    --context)  context="$2"; shift 2 ;;
    --note)     note="$2"; shift 2 ;;
    *) die "handoff: unknown flag $1" ;;
  esac; done
  [ -n "$task" ]    || die "handoff: --task-id required"
  [ -n "$from" ]    || die "handoff: --from required"
  [ -n "$to" ]      || die "handoff: --to required"
  [ -n "$context" ] || die "handoff: --context required"
  context="$(one_line "$context")"
  local blane bfiles blease bstate breason
  IFS='|' read -r blane bfiles blease bstate breason <<EOF
$(latest_block "$task")
EOF
  [ "$blane" = "$from" ] || die "handoff: board shows holding lane $blane, not $from"
  local headline="HANDOFF: $task $from → $to"
  [ -n "$note" ] && headline="$headline — $(one_line "$note")"
  local body
  body="[$from]$headline $(attribution "$from" agent)

$(handoff_block_text "$task" "$from" "$to" "$bstate" "$context" "$breason")

$(claim_block_text "$task" "$to" "$bfiles" "$blease" "$bstate" "$breason")

$(suffix_line "$task" "$from")"
  post_comment "$body"
}

cmd_receipt() {
  local task="" lane="$DEFAULT_LANE" merged="" note=""
  while [ $# -gt 0 ]; do case "$1" in
    --task-id) task="$2"; shift 2 ;;
    --lane)    lane="$2"; shift 2 ;;
    --merged)  merged="$2"; shift 2 ;;
    --note)    note="$2"; shift 2 ;;
    *) die "receipt: unknown flag $1" ;;
  esac; done
  [ -n "$task" ]   || die "receipt: --task-id required"
  [ -n "$merged" ] || die "receipt: --merged required (SHA or 'none')"
  [ -n "$note" ]   || die "receipt: --note required"
  note="$(one_line "$note")"
  local blane bfiles blease _bstate breason
  IFS='|' read -r blane bfiles blease _bstate breason <<EOF
$(latest_block "$task")
EOF
  local body
  body="[$lane]DONE: $task — $note $(attribution "$lane" agent)

$(receipt_block_text "$task" "$merged" "$(attribution "$lane" agent)")

reason: $breason

$(suffix_line "$task" "$lane")"
  post_comment "$body"
}

# ---------------------------------------------------------------------------
# query
# ---------------------------------------------------------------------------

file_rows_json() { # $1 = ROOM-STATE.md path -> {open,expiring,lanes}
  local f="$1"
  [ -f "$f" ] || die "query: state file not found: $f (try --live)"
  awk 'BEGIN{sec=""} /^## /{sec=$0; sub(/^## /,"",sec); next} sec != "" && NF > 0 {print sec "\t" $0}' "$f" \
  | jq -R -s '
      def rows($p): [.[] | select(.sec | startswith($p)) | .line | select(test("^RC-"))
                     | . / " | " | {task_id:.[0], lane:.[1], state:.[2], expires:.[3], files:.[4]}];
      [split("\n")[] | select(length > 0) | split("\t") | {sec:.[0], line:.[1]}]
      | {open: rows("open"),
         expiring: rows("expiring-soon"),
         lanes: ([.[] | select(.sec == "unclaimed-lanes") | .line
                  | select(test("^[A-Za-z0-9_-]+ \\|"))
                  | . / " | " | {lane:.[0], focus:.[1], trust:.[2]}])}'
}

live_rows_json() { # -> {open,expiring,lanes} rebuilt from the board
  local st reg now
  st="$(build_state)"; reg="$(registry_json)"; now="$(date +%s)"
  printf '%s' "$st" | jq --argjson now "$now" --argjson reg "$reg" '
    def is_live($s): (["submitted","working","suspended"] | index($s)) != null;
    def epoch($s): (($s | fromdate) // 0);
    ([.tasks[] | select(is_live(.state))] | sort_by(.lease_expires_at // "9999")) as $o
    | ([$o[] | .lane] | map(select(. != null)) | unique) as $ll
    | {open: [$o[] | {task_id, lane:(.lane // "(none)"), state,
                      expires:(.lease_expires_at // "-"), files:(.files | join(", "))}],
       expiring: [$o[] | select(.state == "working" and .lease_expires_at
                        and ($now < epoch(.lease_expires_at))
                        and (epoch(.lease_expires_at) - $now < 21600))
                  | {task_id, lane:(.lane // "(none)"), state, expires:.lease_expires_at,
                     files:(.files | join(", "))}],
       lanes: ($reg | map(select(.lane as $l | (($ll | index($l)) | not))))}'
}

cmd_query() {
  local qlane="" qstatus="" qfile="" workfor="" live=0 state_path=""
  while [ $# -gt 0 ]; do case "$1" in
    --lane)     qlane="$2"; shift 2 ;;
    --status)   qstatus="$2"; shift 2 ;;
    --file)     qfile="$2"; shift 2 ;;
    --work-for) workfor="$2"; shift 2 ;;
    --live)     live=1; shift ;;
    --state)    state_path="$2"; shift 2 ;;
    *) die "query: unknown flag $1" ;;
  esac; done
  local rows
  if [ "$live" = 1 ]; then rows="$(live_rows_json)"
  else
    [ -n "$state_path" ] || state_path="$(repo_root)/ROOM-STATE.md"
    rows="$(file_rows_json "$state_path")"
  fi
  if [ -n "$workfor" ]; then
    printf 'work-for: %s\n' "$workfor"
    printf '## submitted-but-unclaimed\n'
    printf '%s' "$rows" | jq -r '.open | map(select(.state == "submitted" and .lane == "(none)")) | if length == 0 then "(none)" else (.[] | "\(.task_id) | \(.lane) | \(.state) | \(.expires) | \(.files)") end'
    printf '## leases-expiring-lt-6h\n'
    printf '%s' "$rows" | jq -r '.expiring | if length == 0 then "(none)" else (.[] | "\(.task_id) | \(.lane) | \(.state) | \(.expires) | \(.files)") end'
    printf '## unclaimed-lanes\n'
    printf '%s' "$rows" | jq -r '.lanes | if length == 0 then "(none)" else (.[] | "\(.lane) | \(.focus) | \(.trust)") end'
    return 0
  fi
  printf '%s' "$rows" | jq -r --arg l "$qlane" --arg s "$qstatus" --arg f "$qfile" '
    .open
    | map(select(($l == "" or .lane == $l)
             and ($s == "" or .state == $s)
             and ($f == "" or (.files | contains($f)))))
    | if length == 0 then "(no matching rows)"
      else (.[] | "\(.task_id) | \(.lane) | \(.state) | \(.expires) | \(.files)") end'
}

# ---------------------------------------------------------------------------
# rebuild (enforcer, cron-only)
# ---------------------------------------------------------------------------

cmd_rebuild() {
  local out="" commit_push=0
  while [ $# -gt 0 ]; do case "$1" in
    --out) out="$2"; shift 2 ;;
    --commit-push) commit_push=1; shift ;;
    *) die "rebuild: unknown flag $1" ;;
  esac; done
  [ -n "$out" ] || out="$(repo_root)/ROOM-STATE.md"
  local st reg now bytes
  st="$(build_state)"
  reg="$(registry_json)"
  now="$(date +%s)"
  printf '%s' "$st" | render_md "$now" "$reg" "${ROOM_WATCHER_STATE:-active}" > "$out.tmp" || die "rebuild: render failed"
  mv "$out.tmp" "$out"
  bytes="$(wc -c < "$out" | tr -d ' ')"
  printf 'room: wrote %s (%s bytes)\n' "$out" "$bytes"
  [ "$bytes" -le 2000 ] || warn "exceeds 2000-byte budget ($bytes); tighten caps"
  if [ "$commit_push" = 1 ]; then rebuild_commit_push "$out"; fi
}

rebuild_commit_push() { # $1 = rebuilt file
  local out="$1" rr start_branch staged
  rr="$(repo_root)"
  # Resolve relative --out against the original cwd, then snapshot outside the
  # repo: the branch checkout below would clobber $out when it lives inside the
  # working tree (e.g. --out ROOM-STATE.md run from the repo root), and cp
  # source==dest aborts under set -e.
  case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
  staged="$(mktemp)" || die "rebuild: mktemp failed"
  cp "$out" "$staged" || die "rebuild: snapshot failed"
  # The rebuild above dirtied ROOM-STATE.md in the working tree, and the
  # branch switch below refuses to overwrite local modifications. The fresh
  # content is already snapshotted in $staged — and ROOM-STATE.md is generated
  # (do-not-hand-edit), never a precious local edit — so reset the worktree
  # copy to HEAD before switching branches.
  if git -C "$rr" ls-files --error-unmatch -- ROOM-STATE.md >/dev/null 2>&1 \
     && git -C "$rr" status --porcelain -- ROOM-STATE.md | grep -q .; then
    git -C "$rr" checkout --quiet HEAD -- ROOM-STATE.md \
      || die "rebuild: cannot reset dirty ROOM-STATE.md"
  fi
  start_branch="$(git -C "$rr" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  git -C "$rr" fetch origin main --quiet || die "rebuild: fetch origin/main failed"
  if git -C "$rr" show-ref --verify --quiet refs/remotes/origin/room-state; then
    git -C "$rr" checkout --quiet -B room-state origin/room-state
  else
    git -C "$rr" checkout --quiet -B room-state origin/main
  fi
  cp "$staged" "$rr/ROOM-STATE.md"
  rm -f "$staged"
  if git -C "$rr" status --porcelain -- ROOM-STATE.md | grep -q .; then
    git -C "$rr" add ROOM-STATE.md
    git -C "$rr" -c user.name="quill" -c user.email="quill@local" commit --quiet \
      -m "room-state: rebuild $(iso_now)"
    git -C "$rr" push --quiet origin room-state || die "rebuild: push failed"
    printf 'room: pushed room-state branch\n'
  else
    printf 'room: ROOM-STATE.md unchanged; nothing to push\n'
  fi
  if [ -n "$start_branch" ] && [ "$start_branch" != "room-state" ]; then
    git -C "$rr" checkout --quiet "$start_branch"
  fi
}

# ---------------------------------------------------------------------------
# sweep (enforcer, cron-only)
# ---------------------------------------------------------------------------

human_dur() { # seconds -> 45m | 3h | 2d 4h
  local s="$1"
  if [ "$s" -lt 3600 ]; then printf '%dm' $((s / 60))
  elif [ "$s" -lt 86400 ]; then printf '%dh' $((s / 3600))
  else printf '%dd %dh' $((s / 86400)) $(((s % 86400) / 3600)); fi
}

sweep_emit() { # $1 = PLAN label, $2 = body
  if [ "$DRY_RUN" = 1 ]; then
    printf 'PLAN: %s\n%s\n---\n' "$1" "$2"
  else
    printf 'room: posting: %s\n' "$1"
    post_comment "$2" >/dev/null
  fi
}

sweep_strike_one() { # task_id lane task_json lease_expires_iso now
  local task_id="$1" lane="$2" t="$3" exp_iso="$4" now="$5"
  local iso lease claim_at ago body
  iso="$(iso_now)"
  lease="$(jq -r '.lease // "lease=?h"' <<<"$t")"
  claim_at="$(jq -r '.claim_at' <<<"$t")"
  ago="$(human_dur $((now - $(date -u -d "$exp_iso" +%s))))"
  body="[$DEFAULT_LANE]RECLAIM (strike 1): @$lane — lease on $task_id expired ${ago} ago ($lease posted $claim_at), no heartbeat seen. Please post STATUS within 4h or the claim releases. $(attribution "$DEFAULT_LANE" scheduled)

<!-- room:strike-one:${task_id}:${iso} -->

$(suffix_line "$task_id" "$lane")"
  sweep_emit "strike-one nudge for $task_id (@$lane)" "$body"
}

sweep_strike_two() { # task_id lane task_json
  local task_id="$1" lane="$2" t="$3"
  local iso files lease body
  iso="$(iso_now)"
  files="$(jq -r '(.files // []) | join(", ")' <<<"$t")"
  lease="$(jq -r '.lease // "lease=?h"' <<<"$t")"
  body="[$DEFAULT_LANE]RECLAIM (strike 2): $task_id released. No heartbeat 4h after the strike-one nudge; task returns to submitted with no lane. Files $files are open for a fresh [claim] under a new task-id. $(attribution "$DEFAULT_LANE" scheduled)

\`\`\`room-claim
task-id:    $task_id
lane:
files:      $files
lease:      $lease
state:      submitted
reason:     released by strike-two reclaim: lease expired, no heartbeat 4h after strike-one
\`\`\`

<!-- room:strike-two:${task_id}:${iso} -->

$(suffix_line "$task_id" "$lane")"
  sweep_emit "strike-two release for $task_id" "$body"
}

sweep_illegal() { # task_id from attempted by_lane at comment_id
  local task_id="$1" from="$2" attempted="$3" by="$4" at="$5" cid="$6"
  local iso body
  iso="$(iso_now)"
  body="[$DEFAULT_LANE]RECLAIM (illegal transition rejected): $task_id attempted $from → $attempted at $at (comment $cid); the attempt changes nothing and the task stays at its last legal state. $(attribution "$DEFAULT_LANE" scheduled)

<!-- room:illegal-rejection:${task_id}:${iso} -->

$(suffix_line "$task_id" "${by:-(unknown)}")"
  sweep_emit "illegal-transition rejection for $task_id ($from → $attempted)" "$body"
}

cmd_sweep() {
  local st now actions=0
  st="$(build_state)"
  now="$(date +%s)"
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    local task_id lane exp strike hb
    task_id="$(jq -r '.task_id' <<<"$t")"
    lane="$(jq -r '.lane' <<<"$t")"
    exp="$(jq -r '.lease_expires_at // empty' <<<"$t")"
    strike="$(jq -r '.strike_one_at // empty' <<<"$t")"
    hb="$(jq -r '.heartbeat_at // empty' <<<"$t")"
    [ -n "$exp" ] || continue
    local exp_e; exp_e="$(date -u -d "$exp" +%s)"
    if [ "$now" -gt "$exp_e" ]; then
      if [ -z "$strike" ]; then
        sweep_strike_one "$task_id" "$lane" "$t" "$exp" "$now"; actions=$((actions + 1))
      else
        local strike_e hb_ok=0
        strike_e="$(date -u -d "$strike" +%s)"
        if [ -n "$hb" ]; then
          local hb_e; hb_e="$(date -u -d "$hb" +%s)"
          [ "$hb_e" -gt "$strike_e" ] && hb_ok=1
        fi
        if [ $((now - strike_e)) -gt 14400 ] && [ "$hb_ok" = 0 ]; then
          sweep_strike_two "$task_id" "$lane" "$t"; actions=$((actions + 1))
        fi
      fi
    fi
  done < <(printf '%s' "$st" | jq -c '.tasks[] | select(.state == "working" and .lane != null)')
  while IFS= read -r ill; do
    [ -n "$ill" ] || continue
    local task_id from attempted by at cid noticed
    task_id="$(jq -r '.task_id' <<<"$ill")"
    from="$(jq -r '.from' <<<"$ill")"
    attempted="$(jq -r '.attempted' <<<"$ill")"
    by="$(jq -r '.by_lane // "(unknown)"' <<<"$ill")"
    at="$(jq -r '.at' <<<"$ill")"
    cid="$(jq -r '.comment_id' <<<"$ill")"
    noticed="$(printf '%s' "$st" | jq -r --arg t "$task_id" '.noticed | index($t) // "null"')"
    if [ "$noticed" = "null" ]; then
      sweep_illegal "$task_id" "$from" "$attempted" "$by" "$at" "$cid"; actions=$((actions + 1))
    fi
  done < <(printf '%s' "$st" | jq -c '.illegal[]')
  printf 'room: sweep done, %s action(s)\n' "$actions"
}

# ---------------------------------------------------------------------------
# receipts-scan (enforcer, cron-only)
# ---------------------------------------------------------------------------

digest_items_unchanged() { # $1 = digest body -> 0 when the newest board digest lists the same items
  local new_items old_body old_items
  new_items="$(printf '%s\n' "$1" | grep '^- ' | sort)"
  old_body="$(fetch_comments | jq -r '[.[] | select((.body // "") | startswith("[room-watch] missing receipts"))] | last | .body // ""')"
  [ -n "$old_body" ] || return 1
  old_items="$(printf '%s\n' "$old_body" | grep '^- ' | sort)"
  [ "$new_items" = "$old_items" ]
}

cmd_receipts_scan() {
  local post=0
  while [ $# -gt 0 ]; do case "$1" in
    --post) post=1; shift ;;
    *) die "receipts-scan: unknown flag $1" ;;
  esac; done
  local st now cutoff trows prows
  st="$(build_state)"; now="$(date +%s)"; cutoff=$((now - 86400))
  trows="$(printf '%s' "$st" | jq -r --argjson cut "$cutoff" '
    [.tasks[]
     | select(.state == "completed" and (.receipts | length) == 0)
     | select(((.last_at | fromdate) // 0) < $cut)
     | "TASK\t\(.task_id)\t\(.lane // "(none)")\tcompleted \(.last_at)\tclaim-comment \(.claim_id)"]
    | join("\n")')"
  local prs rcpt_shas
  prs="$(gh_api "repos/$REPO/pulls?state=closed&per_page=100&sort=updated&direction=desc")"
  rcpt_shas="$(printf '%s' "$st" | jq -r '[.tasks[] | .receipts[] | .merged]
    | map(select(. != null and . != "none")) | join(" ")')"
  prows="$(printf '%s' "$prs" | jq -r --argjson cut "$cutoff" --arg shas "$rcpt_shas" '
    [($shas | split(" ") | map(select(length > 0))) as $have
     | .[]
     | select(.merged_at != null)
     | select(((.merged_at | fromdate) // 0) < $cut)
     | .merge_commit_sha as $sha
     | select([$have[] | select($sha | startswith(.))] | length == 0)
     | ((.body // "") | ([capture("·[ \t]*claim:(?<t>[A-Za-z0-9_-]+)")] | .[0].t) // "-") as $ctid
     | "PR\t#\(.number)\tclaim \($ctid)\tmerged \(.merged_at)\tsha \($sha[0:7])"]
    | join("\n")')"
  printf 'room: missing receipts (24h SLO)\n'
  local out=""
  if [ -n "$trows" ]; then out="${out}${trows}"$'\n'; fi
  if [ -n "$prows" ]; then out="${out}${prows}"$'\n'; fi
  if [ -n "$out" ]; then
    printf '%s' "$out" | awk -F'\t' '{printf "%-6s %-14s %-22s %s\n", $1, $2, $3, $4}'
  fi
  if [ "$post" = 1 ] && [ -n "$out" ]; then
    local digest
    digest="[room-watch] missing receipts (24h SLO)

The following completed tasks / merged PRs have no room-receipt block on the board:
$([ -n "$trows" ] && printf '%s\n' "$trows" | awk -F'\t' '{print "- " $1 " " $2 " (" $3 ", " $4 ")"}')
$([ -n "$prows" ] && printf '%s\n' "$prows" | awk -F'\t' '{print "- " $1 " " $2 " (" $3 ", " $4 ")"}')

Receipts close the loop (protocol §6): post DONE: + a room-receipt block with the merge SHA within 24h of the merge."
    if [ "$DRY_RUN" = 1 ]; then
      printf 'PLAN: post prose digest comment\n%s\n' "$digest"
    elif digest_items_unchanged "$digest"; then
      printf 'room: digest unchanged since last board post, skipping\n'
    else
      post_comment "$digest" >/dev/null
      printf 'room: posted digest comment\n'
    fi
  fi
  if [ -n "$out" ]; then return 1; fi
  return 0
}

# ---------------------------------------------------------------------------
# rotation-check, metrics
# ---------------------------------------------------------------------------

cmd_rotation_check() {
  local n due=no
  n="$(comment_count)"
  [ "$n" -ge 1500 ] && due=yes
  printf 'board_comments=%s threshold=1500 rotation_due=%s\n' "$n" "$due"
}

cmd_metrics() {
  local since=""
  while [ $# -gt 0 ]; do case "$1" in
    --since) since="$2"; shift 2 ;;
    *) die "metrics: unknown flag $1" ;;
  esac; done
  local comments n wm st lo hi days cpd
  comments="$(fetch_comments)"
  if [ -n "$since" ]; then
    comments="$(printf '%s' "$comments" | jq --arg s "$since" '[.[] | select(.created_at >= $s)]')"
  fi
  n="$(printf '%s' "$comments" | jq 'length')"
  wm="$(printf '%s' "$comments" | jq 'map(.id) | max // 0')"
  lo="$(printf '%s' "$comments" | jq -r 'map(.created_at) | min // empty')"
  hi="$(printf '%s' "$comments" | jq -r 'map(.created_at) | max // empty')"
  days=1
  if [ -n "$lo" ] && [ -n "$hi" ]; then
    days="$(awk -v a="$(date -u -d "$lo" +%s)" -v b="$(date -u -d "$hi" +%s)" \
      'BEGIN{d=(b-a)/86400; if (d<1) d=1; printf "%.2f", d}')"
  fi
  cpd="$(awk -v n="$n" -v d="$days" 'BEGIN{printf "%.2f", n/d}')"
  st="$(printf '%s' "$comments" | parse_events | reduce_state "$(date +%s)" "$n" "$wm")"
  printf 'claims_opened=%s\n'    "$(printf '%s' "$st" | jq '[.log[] | select((.kind == "claim" or .kind == "prose-claim") and .ok)] | length')"
  printf 'claims_completed=%s\n' "$(printf '%s' "$st" | jq '[.tasks[] | select(.state == "completed")] | length')"
  printf 'claims_expired=%s\n'   "$(printf '%s' "$st" | jq '[.tasks[] | select(.released_at != null)] | length')"
  printf 'prose_claims_opened=%s\n'      "$(printf '%s' "$st" | jq '[.log[] | select(.kind == "prose-claim" and .ok)] | length')"
  printf 'prose_claims_needing_fence=%s\n' "$(printf '%s' "$st" | jq '.unleased_prose_claims | length')"
  printf 'receipts=%s\n'         "$(printf '%s' "$st" | jq '[.tasks[] | .receipts | length] | add // 0')"
  printf 'missing_receipts=%s\n' "$(printf '%s' "$st" | jq '[.tasks[] | select(.state == "completed" and (.receipts | length) == 0)] | length')"
  printf 'distinct_lanes=%s\n'   "$(printf '%s' "$st" | jq '.lanes | length')"
  printf 'comments_per_day=%s\n' "$cpd"
}

# ---------------------------------------------------------------------------
# internal (fixture/testing)
# ---------------------------------------------------------------------------

cmd__parse() { parse_events; }

cmd__state() {
  local now_iso="" n="" wm=""
  while [ $# -gt 0 ]; do case "$1" in
    --now)       now_iso="$2"; shift 2 ;;
    --comments)  n="$2"; shift 2 ;;
    --watermark) wm="$2"; shift 2 ;;
    *) die "_state: unknown flag $1" ;;
  esac; done
  local now events
  if [ -n "$now_iso" ]; then now="$(date -u -d "$now_iso" +%s)"; else now="$(date +%s)"; fi
  events="$(cat)"
  [ -n "$n" ]  || n="$(printf '%s' "$events" | jq 'length')"
  [ -n "$wm" ] || wm="$(printf '%s' "$events" | jq '[.[].id] | max // 0')"
  printf '%s' "$events" | reduce_state "$now" "$n" "$wm"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

main() {
  while [ $# -gt 0 ]; do case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --repo)    REPO="$2"; shift 2 ;;
    --issue)   ISSUE="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown global flag $1" ;;
    *) break ;;
  esac; done
  [ $# -ge 1 ] || { usage >&2; exit 1; }
  local verb="$1"; shift
  need gh; need jq
  case "$verb" in
    help|--help|-h) usage; exit 0 ;;
    claim|heartbeat|release|query|handoff|receipt|rebuild|sweep|receipts-scan|rotation-check|metrics|_parse|_state)
      "cmd_${verb//-/_}" "$@" ;;
    *) printf 'room: unknown verb: %s\n' "$verb" >&2; exit 1 ;;
  esac
}

main "$@"
