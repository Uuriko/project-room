# Supply chain (#3578): dependency install scripts never run during
# installs in this repo. Nothing in the root tree needs one -- the only
# script-bearing root package is fsevents (optional, darwin-only), and
# Playwright browsers are fetched by explicit `npx playwright install`
# steps in the workflows. Secret-bearing workflows also pass
# --ignore-scripts explicitly; this file is the default for every other
# npm install run from the repo root.
ignore-scripts=true
